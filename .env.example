# Distributed Rate Limiter - local development configuration
REDIS_URL=tcp://127.0.0.1:6379

# Server rate limit
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_RATE=2
LEADER_TTL_SECONDS=10
SERVER_INTERVAL_MS=500
NODE_ID=node_A

# Concurrency demo
DEMO_THREADS=32
DEMO_ATTEMPTS=50
DEMO_CAPACITY=100
DEMO_KEYS=16

# Usually leave unset: CMake/test runners configure this automatically.
# Set it only when launching a manually-built binary from another directory.
# RATE_LIMITER_SCRIPT_DIR=/absolute/path/to/distributed-rate-limiter/scripts
